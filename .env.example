# 백엔드(Spring) 주소. 비워두면 같은 오리진의 /api 를 그대로 호출한다.
# 개발 중에는 vite.config.ts 의 프록시가 /api → VITE_PROXY_TARGET 으로 넘겨주므로
# 보통 이 값은 비워두고 VITE_PROXY_TARGET 만 설정한다.
VITE_API_BASE_URL=

# vite dev server 가 /api 를 프록시할 백엔드 주소 (기본값 http://localhost:8080)
VITE_PROXY_TARGET=http://localhost:8080

# 앱 API 키. 저장 공고 등 쓰기 경로(@RequireAppAuth)를 백엔드가 이 키로 가린다.
# 비우면 헤더를 붙이지 않는다 — 백엔드도 APP_API_KEY 가 비어 있으면 인증을 끄므로(개발 모드)
# 로컬에서는 그대로 비워 두면 된다. 운영에서 백엔드 APP_API_KEY 를 켜면 같은 값을 여기에 넣는다.
VITE_APP_API_KEY=

# AI 요약·분석(bid-summary·item-summary·scan-attachments) 호출 여부.
# 'true' 일 때만 부른다 — 백엔드 AI 저장소·첨부 파싱 이식이 끝나기 전에는 500 이 나므로
# 기본은 꺼짐이다. 백엔드 AI_ENABLED(g2b.ai.enabled)를 켠 뒤 여기도 'true' 로 맞춘다.
VITE_AI_ENABLED=
