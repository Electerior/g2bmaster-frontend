# 백엔드(Spring) 주소. 비워두면 같은 오리진의 /api 를 그대로 호출한다.
# 개발 중에는 vite.config.ts 의 프록시가 /api → VITE_PROXY_TARGET 으로 넘겨주므로
# 보통 이 값은 비워두고 VITE_PROXY_TARGET 만 설정한다.
VITE_API_BASE_URL=

# vite dev server 가 /api 를 프록시할 백엔드 주소 (기본값 http://localhost:8080)
VITE_PROXY_TARGET=http://localhost:8080

# 베타 모집 랜딩(/beta)의 접수처 — 구글 Apps Script 웹앱 주소.
# 채우면 랜딩이 Spring 을 거치지 않고 구글 시트에 직접 접수하고, 잔여 자리도 시트의
# 행 개수에서 읽는다. 비우면 /api/beta/status · /api/beta/signups 로 돌아간다.
# 배포 방법은 docs/beta-signup.gs 맨 아래 참고.
VITE_BETA_SHEET_URL=
